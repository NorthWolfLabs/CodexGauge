{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codexgauge-relay-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "3092901",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "3092902",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MACS",
        "class_name": "MacFeedV2"
      },
      {
        "name": "RECEIVERS",
        "class_name": "PushReceiverV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MacFeed"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PushReceiver"
      ]
    },
    {
      "tag": "v3-publisher-driven",
      "deleted_classes": [
        "MacFeed",
        "PushReceiver"
      ],
      "new_sqlite_classes": [
        "MacFeedV2",
        "PushReceiverV2"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "vars": {
    "APNS_KEY_ID": "G6J2XSQR62",
    "APNS_TEAM_ID": "ALPX923Y54",
    "APNS_BUNDLE_ID": "com.northwolflabs.CodexGauge"
  },
  "secrets": {
    "required": [
      "APNS_PRIVATE_KEY"
    ]
  },
  "services": [
    {
      "binding": "DELIVERY",
      "service": "codexgauge-relay-dev",
      "entrypoint": "PushDelivery"
    }
  ]
}
